# Copy to .env.local and fill in your own Raynet CRM trial credentials.
# Get them from: Raynet → Nastavení → Pro vývojáře → API klíče

RAYNET_API_USER=your-raynet-login-email@example.com
RAYNET_API_KEY=your-raynet-api-key
RAYNET_INSTANCE_NAME=your-raynet-instance-name

RAYNET_BASE_URL=https://app.raynet.cz/api/v2